// ~/.config/fastfetch/config.jsonc
// See https://github.com/fastfetch-cli/fastfetch/wiki/Configuration for more details
// See *.jsonc in https://github.com/fastfetch-cli/fastfetch/tree/dev/presets/examples for more examples
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/dotfiles/fastfetch/arch",
    "color": {
      "1": "cyan"
    },
    "type": "file",
    "padding": {
      "top": 8,
      "left": 5,
      "right": 5
    }
  },
  "display": {
    "separator": "    ",
    "color": {
        "keys": "blue",
        "separator": "#3e4b59",
        "output": "white"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "{#italic_yellow}  DATE & TIME INFO {#}"
    },
    "break",
    {
    "type": "datetime",
    "key": "  ",
    "format": "{weekday-short} - {month-name-short} {day-pretty} - {hour-pretty}:{minute-pretty}"
    },
    {
      "type": "command",
      "key": "  󰍃",
      "text": "journalctl --list-boots | grep -e \"^ *-1 \" | awk '{print \"poweroff on \" $7 \", \" $8 \" at \" $9}' "
    },
    {
      "type": "command",
      "key": "  󰚰",
     //"keyColor": "green",
      "text": "grep \"starting full system upgrade\" /var/log/pacman.log | tail -n 1 | awk -F'[[T]' '{print \"system update on \" $2 \" at \" substr($3, 1, 8)}'"
    },
    "break",
    {
      "type": "custom",
      "format": "{#italic_yellow}  SOFTWARE {#}"
    },
    "break",
    {
      "type": "os",
      "key": "  "
    },
    {
      "type": "kernel",
      "key": "  "
    },
    {
      "type": "bootmgr",
      "key": "  󱓞"
    },
    {
      "type": "packages",
      "key": "  󰮯"
    },
    {
      "type": "wm",
      "key": "  󰨇"
    },
    {
      "type": "terminal",
      "key": "  "
    },
    {
      "type": "terminalfont",
      "key": "  ",
      "format": "{combined}"
    },
    "break",
    {
      "type": "custom",
      //"format": "  Hardware "
      "format": "{#italic_yellow}  HARDWARE {#}"
    },
    "break",
    {
      "type": "host",
      "key": "  "
    },
    {
      "type": "cpu",
      "key": "  "
    },
    {
      "type": "gpu",
      "key": "  󱤓"
    },
    {
      "type": "memory",
      "key": "  󰍛"
    },
    {
      "type": "disk",
      "key": "  "
    },
    {
      "type": "display",
      "key": "  󰍹"
    },
    {
      "type": "bluetooth",
      "key": "  󰂯"
    }
  ]
}
