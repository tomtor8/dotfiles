# -*- conf -*-

shell=/usr/bin/fish
font=JetBrainsMono NF:size=14
# window padding rightxtopxleftxbottom
pad=2x2x2x2 center

# import colors
include=~/.local/share/dotfiles/foot/themes/ayu-dark.ini

[colors-dark]
# enable blur and transparency
alpha=1.0
blur=false

[scrollback]
lines=10000

[cursor]
style=block
blink=no

[mouse]
hide-when-typing=yes
