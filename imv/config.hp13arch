# See the manual using `man imv` then `man 5 imv`, `man imv-dir` and `man imv-msg`
# Default config for imv is located in the /etc/imv_config file

[options]

# Suppress built-in key bindings, and specify them explicitly in this
# config file.
# suppress_default_binds = true
background = 0b0e14
# options are none: shows the image at its actual size
# shrink: scales down the image, full: fits the image, crop: fills the window
scaling_mode = full
overlay = false
loop_input = true
# font type and size
overlay_font = Adwaita\ Sans:16
overlay_text_color = b3b1ad
overlay_background_color = 0b0e14
overlay_position_bottom = true
# duration defaults to 0, means no slideshow
# in seconds
# slideshow_duration = 0


[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the
# command.
# for example `x = close` would add alias x to close command
# alias = command to run

[binds]
# Define some key bindings
q = quit
# y = exec echo working!
<Shift+X> = exec rm "$imv_current_file"; close

# Image navigation
<Left> = prev
<bracketleft> = prev
<Right> = next
<bracketright> = next
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0

# Zooming
<Up> = zoom 1
<Shift+plus> = zoom 1
i = zoom 1
<Down> = zoom -1
<minus> = zoom -1
o = zoom -1

# Rotate Clockwise by 90 degrees
<Ctrl+r> = rotate by 90

# Other commands
x = close
f = fullscreen
d = overlay
p = exec echo $imv_current_file
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
r = reset; center

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1
