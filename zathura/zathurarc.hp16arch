set font "Lexend normal 12"
set guioptions ""
set statusbar-basename true
set window-title-basename true
set selection-clipboard "clipboard"
map F file_chooser
map t toggle_index
map x toggle_statusbar
map w adjust_window "width"
map i recolor
set adjust-open "width"

include /home/tom/.local/share/dotfiles/zathura/themes/ayu-dark
